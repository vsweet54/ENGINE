# Wajib untuk database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Rahasia untuk endpoint sinkronisasi manual dan Vercel Cron
CRON_SECRET="ganti-dengan-random-secret-panjang"
ADMIN_SECRET="ganti-dengan-random-secret-berbeda"

# Opsional: upstream OpenAI-compatible untuk chat.
# Tanpa ini, katalog tetap berfungsi tetapi endpoint chat akan memberi 503.
INFERENCE_BASE_URL=""
INFERENCE_API_KEY=""
INFERENCE_DEFAULT_MODEL=""
