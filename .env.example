# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Proteksi sinkronisasi katalog
CRON_SECRET="ganti-dengan-random-secret-panjang"
ADMIN_SECRET="ganti-dengan-random-secret-berbeda"

# OpenRouter: simpan hanya di server Vercel, jangan di frontend/APK
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_SITE_URL="https://neoengine.vercel.app"
OPENROUTER_APP_NAME="NEO AI"
